{
  "name": "metis",
  "version": "0.1.0",
  "private": true,
  "description": "Source-available application for equity research on public companies. It builds reports from SEC filings and market data on your own computer.",
  "keywords": [
    "equity-research",
    "finance",
    "llm",
    "anthropic",
    "nextjs",
    "local-first",
    "sec-edgar",
    "valuation",
    "financial-analysis",
    "typescript",
    "xbrl"
  ],
  "homepage": "https://metis.eligorelick.com",
  "bugs": {
    "url": "https://github.com/eligorelick/Metis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eligorelick/Metis.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Eli Gorelick",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "postcss": "$postcss",
    "esbuild": "0.28.1",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "$minimatch-modern"
    }
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "node scripts/build-with-identity.mjs",
    "start": "next start -H 127.0.0.1",
    "sample:build": "node --conditions=react-server --import tsx scripts/build-sample-report.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content",
    "test": "vitest run --config vitest.config.ts",
    "test:changed": "vitest run --config vitest.config.ts --changed origin/main --passWithNoTests",
    "test:product": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage:core": "vitest run --config vitest.config.ts --coverage",
    "test:coverage:risk": "vitest run --config vitest.risk.config.ts --coverage",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage && node --import tsx scripts/check-coverage.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "export:corrected": "tsx src/report/export/correctedCli.ts",
    "research:evaluate": "node --import tsx scripts/evaluate-research.ts",
    "research:replay": "node --conditions=react-server --import tsx scripts/replay-run-inputs.ts",
    "golden:run": "node --import tsx scripts/golden/run.ts",
    "golden:diff": "node --import tsx scripts/golden/diff.ts",
    "accuracy:check": "node --import tsx scripts/accuracy/check.ts",
    "accuracy:fetch": "node --import tsx scripts/accuracy/fetch.ts",
    "report:drift": "node --import tsx --import ./scripts/golden/offline-preload.mjs scripts/report-drift.ts",
    "reports:evaluate": "node --import tsx scripts/evaluate-reports.ts",
    "claims:evaluate": "node --import tsx scripts/evaluate-claims.ts",
    "settings:reset": "node --conditions=react-server --import tsx scripts/settings-reset.ts",
    "db:push": "node --conditions=react-server node_modules/drizzle-kit/bin.cjs push",
    "check:dependencies": "node scripts/check-dependency-shape.mjs",
    "models:refresh": "node scripts/models-refresh.mjs",
    "costs:reconcile": "node --conditions=react-server --import tsx scripts/reconcile-presumed-costs.mjs",
    "docs:config": "node scripts/docs-config.mjs",
    "docs:pricing": "node --conditions=react-server --import tsx scripts/docs-pricing.mjs",
    "freeze:refresh": "node scripts/freeze-refresh.mjs",
    "audit:security": "node scripts/run-security-audit.mjs",
    "verify": "npm run check:dependencies && npm run typecheck && npm run lint && npm run test:integration && npm run test:coverage && npm run build && npm run audit:security"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@next/env": "16.4.2",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "jose": "6.2.12",
    "lightweight-charts": "^5.2.0",
    "next": "16.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2",
    "server-only": "^0.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "happy-dom": "^21.0.4",
    "minimatch-modern": "npm:minimatch@11.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
