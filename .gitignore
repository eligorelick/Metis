# managed agent-guidance files, see node_modules/next/dist/server/lib/
# generate-agent-files.js). Tracked markdown is limited to the documented
# release set (tests/repository.release.test.ts), so they stay untracked.
AGENTS.md
CLAUDE.md
.claude/
.codex/
.t3/
.superpowers/
